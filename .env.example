# ---------------------------------------------------------------------------
# DocuGenius configuration
# Copy this file to `.env` and fill in your own values:   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Google Gemini (required for AI answers, summaries, chat, translation, search)
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Primary model and comma-separated fallbacks, tried in order on rate limits or outages.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_TIMEOUT_SECONDS=60
# Optional app-side daily request cap to protect a shared key (0 = no cap).
GEMINI_DAILY_REQUEST_LIMIT=0

# --- Reddit (optional, only for Reddit sentiment analysis)
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive user agent that includes your Reddit username.
REDDIT_USER_AGENT=python:docugenius:v2.0 (by /u/your_reddit_username)

# --- Retrieval-Augmented Generation
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
MAX_UPLOAD_MB=20

# --- Server
# Where uploaded PDFs and vector indexes are stored (defaults to the system temp folder).
# DATA_DIR=./data
# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
